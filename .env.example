# Copy this file to .env and fill in your values

# Required: your Anthropic API key
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default: claude-opus-4-5)
# CLAUDE_MODEL=claude-opus-4-5

# ── 2FA authentication ──────────────────────────────────────────────────────
AUTH_PASSWORD=changeme

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=yoursmtppassword

AUTH_EMAIL=you@example.com

# APP_URL=http://localhost:3000

# Listen port (default: 3000)
# PORT=3000

# Optional: path prefix when served behind a reverse proxy sub-path
# e.g. BASE_PATH=/claudia  → app is reachable at https://example.com/claudia
# BASE_PATH=
